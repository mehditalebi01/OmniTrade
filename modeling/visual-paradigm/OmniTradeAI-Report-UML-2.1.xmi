<packagedElement xmi:type="uml:Package" xmi:id="id_679cf8e895d7594a9f65e5cd4a5ec11f" name="Workflow Node Catalog (31 owned node types)">
<packagedElement xmi:type="uml:Component" xmi:id="id_d2b5c087903d5142b9eca4aa4e1d11a0" name="start [control]">
<ownedComment xmi:id="id_2a5c2c236ff75f0382e53f9a537c40df"><body>Starts the workflow and sends the first control signal.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_62a0d2bf1f5158d5a2ce920fa3ce9fac" name="end [control]">
<ownedComment xmi:id="id_f27329987288555fbceea6a1607c790c"><body>Closes the workflow after the final report is ready.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_48211190c0ee5847b09c8bd513b9e960" name="parallel_split [control]">
<ownedComment xmi:id="id_85252484a7a458d6a54fe358fbb71f6d"><body>Opens several branches so data tasks can run at the same time.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_c3b590db94b85f63898dd5f81d953f43" name="join [control]">
<ownedComment xmi:id="id_d5dcff58f045581d91636812c652c742"><body>Waits for connected evidence branches and combines their results.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_b7b61f811d62573e962b2d497498fe12" name="bounded_loop [control]">
<ownedComment xmi:id="id_75b383a0ee0a5f729bac22ddb73bc3b5"><body>Repeats the research debate, but stops at the configured round limit.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_4fbc9904d0365950a6e3ee50e83af937" name="resolve_instrument [evidence]">
<ownedComment xmi:id="id_485646747e775742b23b27e210142b58"><body>Checks the stock ticker and creates one verified instrument identity.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_d138af50eb9b5ac69bdc68ebd575e2a0" name="fetch_market [evidence]">
<ownedComment xmi:id="id_61bac2d817b0584ea5541c1303ea72a1"><body>Collects raw price and volume data for the selected stock.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_24e5b51556415e61b928199fbed257cf" name="fetch_fundamentals [evidence]">
<ownedComment xmi:id="id_534e3b024b9d515ca51342fe8a55bd8e"><body>Collects company statements and financial values.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_006402ab51485f549d3fa14fe402a131" name="fetch_news [evidence]">
<ownedComment xmi:id="id_cf23a783480b5e38a8ca0db0f9fd17d2"><body>Collects recent company and market news from available providers.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_b474b21782ef5aaf88b682546a51119e" name="fetch_macro [evidence]">
<ownedComment xmi:id="id_2042305b995555039c4240c2a97f75a8"><body>Collects economic information that may affect the stock or its sector.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_aab69e4182ff5b89a4d2447626860be6" name="fetch_sentiment [evidence]">
<ownedComment xmi:id="id_bcd1a7304b265341b38478c2d90d93d8"><body>Collects public sentiment signals about the selected stock.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_2eea50f2f43159c0a9ffd6e42b39030d" name="normalize_market [normalization]">
<ownedComment xmi:id="id_2f446420785a5a5eb19f1cc5e0e4b8fb"><body>Converts market data into one clean and consistent format.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_50927b2f517e52e398e9d85f5f084c39" name="normalize_fundamentals [normalization]">
<ownedComment xmi:id="id_ba3d782d520a50debd173bfaffc4bc8d"><body>Cleans financial values and makes their units and currency consistent.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_8bb97792ed4a5784a205ed0d96a3f6a1" name="normalize_text [normalization]">
<ownedComment xmi:id="id_3e609b5fa10a50169f99f53d589335b0"><body>Cleans text evidence and gives news, macro, or sentiment a common format.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_9a93f79daf175094bbfeed4df515905f" name="time_guard [normalization]">
<ownedComment xmi:id="id_8f6cb26ce635520a8d6dba0340962066"><body>Rejects future or stale evidence before it reaches the analyst agents.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_140f636f93c5543dbdf20a1b8e7fee30" name="technical_indicators [calculation]">
<ownedComment xmi:id="id_1f2426e060ae53039bdc6e7952140106"><body>Calculates technical signals from normalized market data.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_02692f24394e5a9e900b2c3a0887728a" name="fundamental_ratios [calculation]">
<ownedComment xmi:id="id_40ba3fbfc936506bb41c8ce190a575f1"><body>Calculates financial ratios used to study company quality and value.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_6526df6a7e4f5c16bee7bfd64a671014" name="market_analyst [specialist]">
<ownedComment xmi:id="id_e5451cee9e5b554e8e23c23cf388d302"><body>Explains price trends, technical signals, uncertainty, and market risks.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_b8ff5d71064757a1b9f3bc35bb264234" name="fundamental_analyst [specialist]">
<ownedComment xmi:id="id_5aa63a6be8325e8c9a480cf5a8180867"><body>Explains the company&#x27;s financial strength, value, and weaknesses.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_56b212e9f3f154b5aedec74e1e3fc081" name="news_analyst [specialist]">
<ownedComment xmi:id="id_7c5905f998c05047ae1c6aed612fbcc9"><body>Explains how recent news and economic events may affect the stock.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_11024ffb1f045be484d9841c79d04e4a" name="sentiment_analyst [specialist]">
<ownedComment xmi:id="id_18e1c3466a8e5e7cb3760b5bf3b2cd0b"><body>Explains public mood and warns when sentiment evidence is weak or noisy.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_fc9a09bd321f5d73b0c29ff390a895ac" name="bull_researcher [research]">
<ownedComment xmi:id="id_a780fbae606558e897bee9b967e3e7a7"><body>Builds the positive case using analyst reports and possible growth factors.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_719c6a1b974f5e79ae1ef8ac4f61252d" name="bear_researcher [research]">
<ownedComment xmi:id="id_fe4732d5327857fb81d16a599331a6ed"><body>Builds the negative case using risks, weak evidence, and downside factors.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_b21bba07544b5a418eb00975dc39c98e" name="research_manager [research]">
<ownedComment xmi:id="id_03ef46cce2115fddb729198b9d0630d9"><body>Compares both research cases and records their agreement and conflicts.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_9a3826a2d09450d09ee6ac74d737b0ed" name="proposal_builder [research]">
<ownedComment xmi:id="id_e790a247502e5834a8d89ea90201bfe8"><body>Turns the research result into a clear BUY, HOLD, or SELL proposal.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_8e0cd0e181d05d01b19fa841f20b175d" name="aggressive_risk [risk]">
<ownedComment xmi:id="id_d80ffb2a83495926a55c2e80c279cb28"><body>Reviews the proposal for a user who accepts higher risk for higher reward.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_2e92def8a3705f31b3deb3aa3f8bf9e8" name="balanced_risk [risk]">
<ownedComment xmi:id="id_952f2e7af33a55a5830d85ad973722c4"><body>Reviews the proposal by balancing possible reward and possible loss.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_a943e63ec8aa59d6a7233fd419631835" name="conservative_risk [risk]">
<ownedComment xmi:id="id_386770e7b83152788a679597ad87bf9f"><body>Reviews the proposal with strong focus on loss prevention and uncertainty.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_1742ae51c7d05f1ea2afb5bf607db4aa" name="risk_join [risk]">
<ownedComment xmi:id="id_a4963b02c3e956b69966f7125b398d6d"><body>Combines the three risk views before the final decision check.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_99f193f732325d708f9226dbcd819eab" name="decision_validator [risk]">
<ownedComment xmi:id="id_d3278d149ecd5506b62c758a77407275"><body>Checks that the decision agrees with evidence, risk rules, and confidence limits.</body></ownedComment>
</packagedElement>
<packagedElement xmi:type="uml:Component" xmi:id="id_9df9b554151153e0947a03c001ee9be3" name="report_renderer [output]">
<ownedComment xmi:id="id_744bc635d9cd5e4a8709224a53262a22"><body>Builds the final readable report with agent views and evidence links.</body></ownedComment>
</packagedElement>
</packagedElement>
</uml:Model>
</xmi:XMI>
